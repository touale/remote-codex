{
  "identifier": "desktop",
  "description": "Window-scoped application commands. Rust checks resource ownership.",
  "windows": [
    "main",
    "workspace-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-attach",
    "allow-server-authentication",
    "allow-catalog",
    "allow-server-save",
    "allow-server-remove",
    "allow-server-config",
    "allow-workspace-open",
    "allow-workspace-remove",
    "allow-workspace-close",
    "allow-directory-open",
    "allow-directory-close",
    "allow-directory-browse",
    "allow-directory-create",
    "allow-file-context-open",
    "allow-file-context-close",
    "allow-file-list",
    "allow-file-read",
    "allow-file-write",
    "allow-file-change",
    "allow-project-mcp",
    "allow-terminal-open",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-close",
    "allow-native-status",
    "allow-native-usage",
    "allow-session-defaults",
    "allow-app-preferences",
    "allow-native-login",
    "allow-native-select",
    "allow-session-open",
    "allow-session-trust",
    "allow-session-action",
    "allow-session-history",
    "allow-session-close",
    "allow-session-metadata",
    "allow-session-mcp",
    "allow-session-snapshot",
    "allow-session-status",
    "allow-preferences",
    "allow-acknowledge",
    "allow-authentication-answer",
    "allow-cancel-operation",
    "allow-new-window",
    "allow-close-window",
    "allow-external-link",
    "allow-transfer-pick",
    "allow-transfer-upload",
    "allow-transfer-download",
    "allow-transfer-discard-grant",
    "allow-transfer-list",
    "allow-transfer-run",
    "allow-transfer-action",
    "allow-transfer-skipped",
    "allow-transfer-reveal"
  ]
}
