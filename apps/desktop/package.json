{
  "name": "remote-codex-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b && tsc -p tsconfig.e2e.json",
    "check:frontend": "npm run format:check && npm run check && npm test && npm run build",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts wdio.conf.ts tsconfig*.json package.json",
    "format:check": "prettier --check src tests vite.config.ts wdio.conf.ts tsconfig*.json package.json",
    "test:e2e": "wdio run wdio.conf.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-menu": "2.1.24",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "9.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "radix-ui": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/cli": "^9.31.7",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@puppeteer/browsers": "^3.2.2",
    "mocha": "^11.7.5",
    "serialize-javascript": "^7.0.5",
    "diff": "9.0.0"
  }
}
